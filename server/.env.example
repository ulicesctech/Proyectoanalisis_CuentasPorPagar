# Copia este archivo como server/.env y completa los valores. No lo subas con credenciales.

# --- Oracle ---
NODE_ORACLEDB_USER=
NODE_ORACLEDB_PASSWORD=
NODE_ORACLEDB_CONNECTIONSTRING=host:1521/service_name

# --- Servidor ---
PORT=3000
# 127.0.0.1 solo acepta conexiones del mismo equipo. Usa 0.0.0.0 para permitir la red local.
HOST=127.0.0.1
# Orígenes del cliente permitidos por CORS, separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:5173

# --- Identidad CXP ---
# provisional: el usuario se elige en pantalla (encabezado X-CXP-Actor-Id). NO autentica
# y no arranca con NODE_ENV=production.
CXP_AUTH_MODE=provisional

# --- Documentos DTE (opcional) ---
# CXP_DTE_STORAGE_DIR=/ruta/absoluta/al/almacenamiento
# CXP_DTE_MAX_BYTES=10485760
