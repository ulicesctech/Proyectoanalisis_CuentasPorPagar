# Copia este archivo como server/.env y completa los valores. No lo subas con credenciales.

# --- Oracle ---
NODE_ORACLEDB_USER=
NODE_ORACLEDB_PASSWORD=
NODE_ORACLEDB_CONNECTIONSTRING=host:1521/service_name

# --- Servidor ---
PORT=3000
# 127.0.0.1 solo acepta conexiones del mismo equipo. Usa 0.0.0.0 para permitir la red local.
HOST=127.0.0.1
# Orígenes del cliente permitidos por CORS, separados por coma, sin barra final.
CORS_ORIGINS=http://localhost:5173

# --- Sesiones CXP ---
# La cookie Secure es obligatoria en producción. Solo para desarrollo HTTP local:
# AUTH_ALLOW_INSECURE_HTTP=true
# AUTH_ALLOW_INSECURE_HTTP=false
# Vencimiento por inactividad (minutos) y absoluto (horas).
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=8
# Bloqueo de cuenta tras fallos y límite adicional por IP del socket.
AUTH_MAX_FAILURES=5
AUTH_LOCK_MINUTES=15
AUTH_IP_MAX_ATTEMPTS=20
AUTH_IP_WINDOW_MINUTES=15
# Solo para aprovisionamiento manual, definir en la terminal con el destino revisado:
# CXP_PROVISION_TARGET=<mismo valor que NODE_ORACLEDB_CONNECTIONSTRING>

# --- Documentos DTE (opcional) ---
# CXP_DTE_STORAGE_DIR=/ruta/absoluta/al/almacenamiento
# Directorio absoluto en un volumen persistente compartido por las instancias de la API.
# CXP_DTE_STORAGE_DIR=/var/lib/erp/cxp-dte
# CXP_DTE_STORAGE_DIR=C:\ERP\cxp-dte
# Tamaño máximo en bytes (predeterminado: 10485760; máximo configurable: 52428800).
# CXP_DTE_MAX_BYTES=10485760
