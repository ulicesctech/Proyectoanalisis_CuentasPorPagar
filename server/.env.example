PORT=3000
NODE_ORACLEDB_USER=
NODE_ORACLEDB_PASSWORD=
NODE_ORACLEDB_CONNECTIONSTRING=host:1521/service_name

# Directorio absoluto en un volumen persistente compartido por las instancias de la API.
# CXP_DTE_STORAGE_DIR=/var/lib/erp/cxp-dte
# CXP_DTE_STORAGE_DIR=C:\ERP\cxp-dte
# Tamaño máximo en bytes (predeterminado: 10485760; máximo configurable: 52428800).
# CXP_DTE_MAX_BYTES=10485760
